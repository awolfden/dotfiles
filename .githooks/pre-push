#!/bin/sh
# Local safety net, not a security boundary: hooks can be bypassed.
set -eu
root=$(git rev-parse --show-toplevel)
while read -r local_ref local_oid remote_ref remote_oid; do
  if [ "$local_ref" != refs/heads/main ] || [ "$remote_ref" != refs/heads/main ]; then
    echo 'Refusing automatic publication of refs other than main.' >&2
    exit 1
  fi
done
exec python3 -B "$root/bootstrap/publication_check.py" --release
